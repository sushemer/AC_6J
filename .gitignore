**/build*/
**/sdkconfig.old
**/sdkconfig
!**/sdkconfig.defaults
**/managed_components/
**/dependencies.lock

# Binarios y salidas de compilación
*.bin
*.elf
*.map
*.pyc
**/__pycache__/

# Logs y archivos temporales
*.log
*.tmp
*.bak
*.swp

# Configuración específica de una computadora
**/settings-DESKTOP-*.json
**/settings-LAPTOP-*.json
